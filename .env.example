# Environment Variables Template

Copy this file to `.env.local` and fill in the actual values.

# Supabase Configuration
# Found in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Lofty API Configuration
# Found in: Lofty Account Settings -> API
LOFTY_API_KEY=your_lofty_api_key
LOFTY_API_BASE_URL=https://api.lofty.com
